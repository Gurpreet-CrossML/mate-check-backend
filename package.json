{
  "name": "mate-check-api",
  "version": "0.1.0",
  "private": true,
  "description": "Express backend for mate-check mobile app (OpenAI chat + D-ID talking-avatar clips). Deploys to Vercel.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-network-family-autoselection' tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.56.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}